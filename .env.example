# Copy to app/.env.local (never commit real secrets)

# Stellar testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=CBBZVOGZ7CSEQUW46OUMT3X7K22Q2GZYTRGOKJDTJIZTUGU36I24L3ZR

# Supabase (server-only access; Row Level Security blocks the public key)
SUPABASE_URL=https://pipgmdjflocigbyjcvhg.supabase.co
# Dashboard -> Project Settings -> API Keys -> Secret keys
SUPABASE_SECRET_KEY=

# Public values for the browser (only used to send a PDF to a one-time signed
# upload link; Row Level Security blocks this key from reading anything)
NEXT_PUBLIC_SUPABASE_URL=https://pipgmdjflocigbyjcvhg.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_iEb-KpKtdAH9iwemS5DMqg_F2eZ9neq

# 32+ random bytes, base64. Signs session cookies and encrypts invite secrets.
# Generate (any OS with Node): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
INVITE_ENCRYPTION_KEY=

# Email (Resend)
RESEND_API_KEY=
# No domain yet? Use Resend's test sender. It can ONLY deliver to the email on
# your Resend account. Verify a domain in Resend to email anyone else.
EMAIL_FROM="Signcerely <onboarding@resend.dev>"

# Optional: base URL used in email links (defaults to the current host)
APP_URL=
